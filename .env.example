# data.go.kr 인증키 (인천국제공항공사 B551177 서비스 활용신청 필요)
# 발급받은 "일반 인증키(Encoding)" 를 그대로 넣는다. 이미 %-인코딩된 문자열이라
# 절대 재인코딩하지 마라 — 재인코딩하면 SERVICE_KEY_IS_NOT_REGISTERED_ERROR(코드 30) 가 난다.
DATA_GO_KR_KEY=

# Vercel Cron 캐시 예열(/api/warm) 인증용. Vercel 이 크론 호출에
# Authorization: Bearer <이 값> 을 붙여 보낸다. 설정 안 하면 /api/warm 은
# 503(fail closed) — 공개로 뚫려 아무나 예열을 돌리지 못하게 한다.
# 생성: openssl rand -hex 32
CRON_SECRET=
